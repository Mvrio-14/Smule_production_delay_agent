# Supabase: Project > Connect > "Transaction pooler" URI (port 6543). Works locally and on Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# OpenAI API key (platform.openai.com)
OPENAI_API_KEY=
# Optional: xAI API key (console.x.ai), only needed to run a Grok model
XAI_API_KEY=
# Model to use, as provider:model-id. Default: openai:gpt-6.1-sol. Cheap comparison: openai:gpt-6-luna. Grok: xai:<model-id>
MODEL=openai:gpt-6.1-sol
