# Supabase: Project > Connect > "Transaction pooler" URI (port 6543). Works locally and on Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# xAI API key from console.x.ai
XAI_API_KEY=
# Grok model id, change it to compare models
XAI_MODEL=
